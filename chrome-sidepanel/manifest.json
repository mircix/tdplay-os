{
  "manifest_version": 3,
  "name": "TDPlay OS — Instagram side panel",
  "version": "1.7.0",
  "key": "",
  "description": "Docks Instagram (and TDPlay OS) in Chrome's side panel, the way Ask Gemini docks.",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "Instagram side panel" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "sw.js" },
  "permissions": ["sidePanel", "declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": ["https://*.instagram.com/*", "https://mircix.github.io/*"],
  "content_scripts": [
    { "matches": ["https://*.instagram.com/*"], "all_frames": true, "run_at": "document_idle", "js": ["recover.js"] },
    { "matches": ["https://mircix.github.io/*", "http://localhost/*", "http://127.0.0.1/*"], "all_frames": true, "run_at": "document_start", "js": ["bridge.js"] }
  ],
  "externally_connectable": { "matches": ["https://mircix.github.io/*", "http://127.0.0.1/*", "http://localhost/*"] }
}
