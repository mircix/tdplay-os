{
  "manifest_version": 3,
  "name": "TDPlay OS — Instagram side panel",
  "version": "1.1.0",
  "description": "Docks Instagram (and TDPlay OS) in Chrome's side panel, the way Ask Gemini docks.",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "Instagram side panel" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "sw.js" },
  "permissions": ["sidePanel", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.instagram.com/*", "https://mircix.github.io/*"]
}
